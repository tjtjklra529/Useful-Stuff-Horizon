{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:model",
      "model": "things:item/slingshot"
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "entries": [
        {
          "threshold": 8,
          "model": {
            "type": "minecraft:model",
            "model": "things:item/slingshot_pulling_1"
          }
        },
        {
          "threshold": 12,
          "model": {
            "type": "minecraft:model",
            "model": "things:item/slingshot_pulling_mid"
          }
        },
        {
          "threshold": 16,
          "model": {
            "type": "minecraft:model",
            "model": "things:item/slingshot_pulling_2"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "things:item/slingshot_charging"
      }
    }
  }
}
